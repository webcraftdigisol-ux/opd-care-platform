generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  PHARMACIST
  LAB_TECHNICIAN
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

// A clinic is a tenant. Every clinic-owned record is scoped by clinicId so
// one deployment can serve many clinics with isolated data.
model Clinic {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String   @unique
  tier                      Int      @default(1) // 1 = OPD, 2 = +Pharmacy/Lab, 3 = +IPD
  logoUrl                   String?
  taxPercent                Float    @default(0)
  doctorRevenueSharePercent Float    @default(0)
  createdAt                 DateTime @default(now())

  users         User[]
  appointments  Appointment[]
  pharmacyItems PharmacyItem[]
  pharmacySales PharmacySale[]
  labCatalog    LabTestCatalog[]
  labInvoices   LabInvoice[]
}

model User {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email     String
  phone     String?
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile        DoctorProfile?
  appointments         Appointment[]  @relation("PatientAppointments")
  pharmacyPurchases    PharmacySale[] @relation("PharmacySalePatient")
  pharmacySalesHandled PharmacySale[] @relation("PharmacySaleSeller")
  labResultsOrdered    LabInvoice[]   @relation("LabInvoicePatient")
  labResultsRecorded   LabInvoice[]   @relation("LabInvoiceRecorder")

  @@unique([clinicId, email])
  @@unique([clinicId, phone])
  @@index([clinicId])
}

model DoctorProfile {
  id             String @id @default(uuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  department     String
  slotMinutes    Int    @default(15)

  schedules    Schedule[]
  appointments Appointment[] @relation("DoctorAppointments")
}

model Schedule {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String

  @@index([doctorId])
}

model Appointment {
  id          String            @id @default(uuid())
  clinicId    String
  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId    String
  doctor      DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  date        DateTime
  tokenNumber Int
  status      AppointmentStatus @default(BOOKED)
  isWalkIn    Boolean           @default(false)
  reason      String?
  createdAt   DateTime          @default(now())

  consultation  Consultation?
  pharmacySales PharmacySale[]
  labInvoices   LabInvoice[]

  @@index([clinicId])
  @@index([doctorId, date])
  @@index([patientId])
}

model Consultation {
  id                String      @id @default(uuid())
  appointmentId     String      @unique
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  vitals            Json?
  diagnosis         String?
  notes             String?
  followUpDate      DateTime?
  followUpContacted Boolean     @default(false)
  createdAt         DateTime    @default(now())

  prescriptions   Prescription[]
  labTestsOrdered LabTestOrder[]

  @@index([followUpDate])
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medicine       String
  dosage         String
  frequency      String
  durationDays   Int
  notes          String?

  saleItems PharmacySaleItem[]

  @@index([consultationId])
}

// ---- Pharmacy (Tier 2+) ----

// Pricing is always normalized to a base unit (a tablet/piece), never left
// ambiguous between "per strip" and "per unit" — every quantity x price
// calculation elsewhere in the app multiplies quantityInUnits x pricePerUnit,
// regardless of how the item is packaged.
model PharmacyItem {
  id               String   @id @default(uuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name             String
  unitsPerStrip    Int? // null = sold per unit directly (e.g. a syrup bottle)
  pricePerUnit     Float
  costPricePerUnit Float
  stockUnits       Int      @default(0)
  createdAt        DateTime @default(now())

  saleItems PharmacySaleItem[]

  @@index([clinicId])
}

model PharmacySale {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User         @relation("PharmacySalePatient", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  soldById      String
  soldBy        User         @relation("PharmacySaleSeller", fields: [soldById], references: [id])
  taxPercent    Float        @default(0)
  subtotal      Float
  taxAmount     Float
  total         Float
  createdAt     DateTime     @default(now())

  items PharmacySaleItem[]

  @@index([clinicId])
  @@index([patientId])
}

model PharmacySaleItem {
  id             String        @id @default(uuid())
  saleId         String
  sale           PharmacySale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  itemId         String?
  item           PharmacyItem? @relation(fields: [itemId], references: [id])
  medicineName   String
  quantity       Int
  unitPrice      Float
  lineTotal      Float

  @@index([saleId])
}

// ---- Lab (Tier 2+) ----

// Created when a doctor saves a consultation that orders lab tests. Free-text
// name, since at order time there may be no catalog match yet.
model LabTestOrder {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  testName       String
  notes          String?

  resultItems LabResultItem[]

  @@index([consultationId])
}

model LabTestCatalog {
  id          String          @id @default(uuid())
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  resultItems LabResultItem[]

  @@index([clinicId])
}

model LabInvoice {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User         @relation("LabInvoicePatient", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  recordedById  String
  recordedBy    User         @relation("LabInvoiceRecorder", fields: [recordedById], references: [id])
  taxPercent    Float        @default(0)
  subtotal      Float
  taxAmount     Float
  total         Float
  createdAt     DateTime     @default(now())

  items LabResultItem[]

  @@index([clinicId])
  @@index([patientId])
}

model LabResultItem {
  id            String          @id @default(uuid())
  invoiceId     String
  invoice       LabInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId       String?
  order         LabTestOrder?   @relation(fields: [orderId], references: [id])
  catalogItemId String?
  catalogItem   LabTestCatalog? @relation(fields: [catalogItemId], references: [id])
  testName      String
  resultText    String?
  price         Float

  @@index([invoiceId])
}
