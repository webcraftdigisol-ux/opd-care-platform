generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  PHARMACIST
  LAB_TECHNICIAN
  RADIOLOGY_TECHNICIAN
  RECEPTIONIST
  NURSE
  HEAD_NURSE
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BillType {
  CONSULTATION
  PHARMACY
  LAB
  RADIOLOGY
  IPD
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NETBANKING
  WALLET
  RAZORPAY
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationType {
  APPOINTMENT_CONFIRMED
  PAYMENT_RECEIVED
  FOLLOWUP_REMINDER
  DISCHARGE_SUMMARY
  APPOINTMENT_REMINDER
  PRESCRIPTION_SHARED
  DIET_PLAN_SHARED
  PASSWORD_RESET_OTP
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

enum AttachmentCategory {
  LAB_REPORT
  RADIOLOGY_REPORT
  PRESCRIPTION_SCAN
  // A raw DICOM export from an imaging modality (the common workaround at a
  // clinic without a full PACS: a USB stick or CD handed over at the scan),
  // distinct from RADIOLOGY_REPORT (a written report as PDF/image) so the
  // same radiology invoice can carry both. See the in-browser viewer note
  // in README.md's File Attachments section for what this does and doesn't
  // cover (single uncompressed frame only -- no DICOM network protocols).
  RADIOLOGY_DICOM
}

// A clinic is a tenant. Every clinic-owned record is scoped by clinicId so
// one deployment can serve many clinics with isolated data.
model Clinic {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String   @unique
  tier                      Int      @default(1) // 1 = OPD, 2 = +Pharmacy/Lab/Radiology, 3 = +IPD
  logoUrl                   String?
  taxPercent                Float    @default(0)
  doctorRevenueSharePercent Float    @default(0)
  // Last Patient ID number handed out (PT000001, PT000002, ...), bumped
  // atomically by nextPatientCode() in utils/patients.ts.
  lastPatientNumber         Int      @default(0)
  createdAt                 DateTime @default(now())

  users             User[]
  appointments      Appointment[]
  pharmacyItems     PharmacyItem[]
  pharmacySales     PharmacySale[]
  labCatalog        LabTestCatalog[]
  labInvoices       LabInvoice[]
  radiologyCatalog  RadiologyCatalog[]
  radiologyInvoices RadiologyInvoice[]
  wards             Ward[]
  admissions        Admission[]
  payments          Payment[]
  paymentOrders     PaymentOrder[]
  notifications     Notification[]
  attachments       Attachment[]
  subscription      Subscription?
  dietPlans         DietPlan[]
  patientProfiles   PatientProfile[]
}

model User {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email     String
  phone     String?
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // WhatsApp Business messaging requires the recipient's own opt-in consent
  // before a business can send them template messages (Meta policy, not
  // just good practice) -- unset by default, a patient turns it on
  // themself. `phone` doubles as the WhatsApp number; no separate field,
  // to avoid the two silently drifting apart.
  whatsappOptIn Boolean @default(false)
  // When consent was last given, and by whom: null recordedById means the
  // patient opted in themself; otherwise it's the staff member who recorded
  // the patient's in-person consent at walk-in registration. Kept as a plain
  // id rather than a relation -- it's an audit trail, not something queried.
  whatsappOptInAt           DateTime?
  whatsappOptInRecordedById String?

  doctorProfile            DoctorProfile?
  patientProfile           PatientProfile?
  passwordResetOtps        PasswordResetOtp[]
  appointments             Appointment[]      @relation("PatientAppointments")
  pharmacyPurchases        PharmacySale[]     @relation("PharmacySalePatient")
  pharmacySalesHandled     PharmacySale[]     @relation("PharmacySaleSeller")
  labResultsOrdered        LabInvoice[]       @relation("LabInvoicePatient")
  labResultsRecorded       LabInvoice[]       @relation("LabInvoiceRecorder")
  radiologyResultsOrdered  RadiologyInvoice[] @relation("RadiologyInvoicePatient")
  radiologyResultsRecorded RadiologyInvoice[] @relation("RadiologyInvoiceRecorder")
  admissions               Admission[]
  vitalsRecorded           IpdVitals[]
  paymentsMade             Payment[]      @relation("PatientPayments")
  paymentsRecorded         Payment[]      @relation("PaymentsRecorded")
  paymentOrdersInitiated   PaymentOrder[] @relation("PaymentOrdersInitiated")
  subscriptionPaymentsPaid SubscriptionPayment[] @relation("SubscriptionPaymentsPaid")
  notificationsReceived    Notification[] @relation("PatientNotifications")
  attachmentsOwned         Attachment[]   @relation("PatientAttachments")
  attachmentsUploaded      Attachment[]   @relation("AttachmentsUploaded")
  dietPlansOwned           DietPlan[]     @relation("PatientDietPlans")
  dietPlansCreated         DietPlan[]     @relation("DietPlansAuthored")

  @@unique([clinicId, email])
  // Not unique: family members often share one mobile number, so a
  // patient's identity is their Patient ID, not their phone.
  @@index([clinicId, phone])
  @@index([clinicId])
}

// The clinical/demographic record behind a PATIENT user. Every patient has
// one (created with the account, backfilled for older ones); `name` on User
// stays the full display name, kept in step with first/middle/last here.
model PatientProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  // Human-readable, per clinic, never reused: PT000001.
  patientCode String

  firstName     String
  middleName    String?
  lastName      String?
  gender        String? // MALE | FEMALE | OTHER
  dateOfBirth   DateTime?
  // Age in years as told at registration, when the DOB isn't known. The
  // current age is derived from ageRecordedAt so it stays right over time.
  ageYears      Int?
  ageRecordedAt DateTime?
  bloodGroup    String?
  maritalStatus String?
  nationality   String?

  alternatePhone   String?
  emergencyContact String?
  occupation       String?
  referredBy       String?

  address String?
  city    String?
  state   String?
  pincode String?

  heightCm         Float?
  weightKg         Float?
  allergies        String?
  chronicDiseases  String?
  pastSurgeries    String?
  familyHistory    String?

  insuranceDetails String?
  tpa              String?
  doctorNotes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, patientCode])
  @@index([clinicId])
}

model DoctorProfile {
  id              String @id @default(uuid())
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  String
  department      String
  slotMinutes     Int    @default(15)
  consultationFee Float  @default(0)

  schedules    Schedule[]
  appointments Appointment[]    @relation("DoctorAppointments")
  admissions   Admission[]
  ipdVisits    IpdDoctorVisit[]
}

model Schedule {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String

  @@index([doctorId])
}

model Appointment {
  id          String            @id @default(uuid())
  clinicId    String
  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId    String
  doctor      DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  date        DateTime
  tokenNumber Int
  // "HH:mm", 24h. Set for a patient-booked, fixed-slot appointment; null for
  // a walk-in, which is queued in as-they-arrive rather than pre-slotted.
  // Deliberately not a DB unique constraint: a CANCELLED appointment must
  // free its slot for rebooking, and Postgres has no partial-unique support
  // through Prisma's schema DSL without a hand-written migration. Guarded
  // instead the same way bed occupancy is (see ipd.routes.ts admitPatient):
  // an application-level check against non-cancelled rows, inside a
  // transaction to keep the race window as small as it is elsewhere.
  startTime       String?
  status          AppointmentStatus @default(BOOKED)
  isWalkIn        Boolean           @default(false)
  reason          String?
  // Snapshotted from DoctorProfile.consultationFee at booking time -- the
  // same "own recorded charge" discipline as Pharmacy/Lab/Radiology, so a
  // later change to the doctor's fee never rewrites an already-booked visit.
  consultationFee Float             @default(0)
  createdAt       DateTime          @default(now())
  // Set the first time the day-before reminder job attempts this
  // appointment (see server/src/utils/reminders.ts), whatever the actual
  // send outcome (SENT/FAILED/SKIPPED -- see the Notification row it
  // writes). This is an attempted-once guard, not a delivery guarantee,
  // the same "one attempt, always logged" discipline as every other
  // notification in this app; it just needs to stop the hourly job from
  // re-sending the same reminder every time it runs.
  reminderSentAt  DateTime?

  consultation      Consultation?
  pharmacySales     PharmacySale[]
  labInvoices       LabInvoice[]
  radiologyInvoices RadiologyInvoice[]

  @@index([clinicId])
  @@index([doctorId, date, startTime])
  @@index([patientId])
}

model Consultation {
  id                String      @id @default(uuid())
  appointmentId     String      @unique
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  vitals            Json?
  diagnosis         String?
  notes             String?
  followUpDate      DateTime?
  followUpContacted Boolean     @default(false)
  // Set when the automatic day-before follow-up reminder was attempted
  // (whatever its outcome), so the hourly job sends it at most once.
  followUpReminderSentAt DateTime?
  createdAt         DateTime    @default(now())

  prescriptions    Prescription[]
  labTestsOrdered  LabTestOrder[]
  radiologyOrdered RadiologyTestOrder[]
  dietPlans        DietPlan[]

  @@index([followUpDate])
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medicine       String
  dosage         String
  frequency      String
  durationDays   Int
  notes          String?

  saleItems PharmacySaleItem[]

  @@index([consultationId])
}

enum DietaryPreference {
  VEG
  NON_VEG
  EGGETARIAN
  VEGAN
}

// A doctor-authored diet recommendation, informed by (but not mechanically
// derived from) the patient's medical history/current complaints -- both
// already available via the optional consultation link -- plus allergies,
// dietary preference, and what's realistically available where the patient
// lives, so the plan is something they can actually follow. consultationId
// is optional (SetNull on delete) rather than required like Prescription's,
// since a plan can also be authored/updated outside a single visit (e.g. a
// follow-up adjustment) and still needs to stay attached to the patient.
model DietPlan {
  id                String            @id @default(uuid())
  clinicId          String
  clinic            Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId         String
  patient           User              @relation("PatientDietPlans", fields: [patientId], references: [id])
  consultationId    String?
  consultation      Consultation?     @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User              @relation("DietPlansAuthored", fields: [createdById], references: [id])
  dietaryPreference DietaryPreference
  allergies         String?
  localFoodNotes    String?
  planText          String
  createdAt         DateTime          @default(now())

  @@index([clinicId])
  @@index([patientId])
}

// ---- Pharmacy (Tier 2+) ----

// Pricing is always normalized to a base unit (a tablet/piece), never left
// ambiguous between "per strip" and "per unit" — every quantity x price
// calculation elsewhere in the app multiplies quantityInUnits x pricePerUnit,
// regardless of how the item is packaged.
model PharmacyItem {
  id               String   @id @default(uuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name             String
  brand            String? // manufacturer/brand name, e.g. "Crocin" for paracetamol -- optional, purely informational
  unitsPerStrip    Int? // null = sold per unit directly (e.g. a syrup bottle)
  pricePerUnit     Float
  costPricePerUnit Float
  stockUnits       Int      @default(0)
  createdAt        DateTime @default(now())

  saleItems PharmacySaleItem[]

  @@index([clinicId])
}

model PharmacySale {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User         @relation("PharmacySalePatient", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  admissionId   String?
  admission     Admission?   @relation(fields: [admissionId], references: [id])
  soldById      String
  soldBy        User         @relation("PharmacySaleSeller", fields: [soldById], references: [id])
  taxPercent    Float        @default(0)
  subtotal      Float
  taxAmount     Float
  total         Float
  createdAt     DateTime     @default(now())

  items PharmacySaleItem[]

  @@index([clinicId])
  @@index([patientId])
  @@index([admissionId])
}

model PharmacySaleItem {
  id             String        @id @default(uuid())
  saleId         String
  sale           PharmacySale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  itemId         String?
  item           PharmacyItem? @relation(fields: [itemId], references: [id])
  medicineName   String
  quantity       Int
  unitPrice      Float
  lineTotal      Float

  @@index([saleId])
}

// ---- Lab (Tier 2+) ----

// Created when a doctor saves a consultation that orders lab tests. Free-text
// name, since at order time there may be no catalog match yet.
model LabTestOrder {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  testName       String
  notes          String?

  resultItems LabResultItem[]

  @@index([consultationId])
}

model LabTestCatalog {
  id          String          @id @default(uuid())
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  resultItems LabResultItem[]

  @@index([clinicId])
}

model LabInvoice {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User         @relation("LabInvoicePatient", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  admissionId   String?
  admission     Admission?   @relation(fields: [admissionId], references: [id])
  recordedById  String
  recordedBy    User         @relation("LabInvoiceRecorder", fields: [recordedById], references: [id])
  taxPercent    Float        @default(0)
  subtotal      Float
  taxAmount     Float
  total         Float
  createdAt     DateTime     @default(now())

  items LabResultItem[]

  @@index([clinicId])
  @@index([patientId])
  @@index([admissionId])
}

model LabResultItem {
  id            String          @id @default(uuid())
  invoiceId     String
  invoice       LabInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId       String?
  order         LabTestOrder?   @relation(fields: [orderId], references: [id])
  catalogItemId String?
  catalogItem   LabTestCatalog? @relation(fields: [catalogItemId], references: [id])
  testName      String
  resultText    String?
  price         Float

  @@index([invoiceId])
}

// ---- Radiology (Tier 2+) ----
// Mirrors the Lab module's pattern exactly: a doctor's free-text order at
// consultation time, a priced catalog, and a counter workflow that
// auto-matches the order to the catalog by name.

model RadiologyTestOrder {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  testName       String
  notes          String?

  resultItems RadiologyResultItem[]

  @@index([consultationId])
}

model RadiologyCatalog {
  id          String                @id @default(uuid())
  clinicId    String
  clinic      Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  resultItems RadiologyResultItem[]

  @@index([clinicId])
}

model RadiologyInvoice {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User         @relation("RadiologyInvoicePatient", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  admissionId   String?
  admission     Admission?   @relation(fields: [admissionId], references: [id])
  recordedById  String
  recordedBy    User         @relation("RadiologyInvoiceRecorder", fields: [recordedById], references: [id])
  taxPercent    Float        @default(0)
  subtotal      Float
  taxAmount     Float
  total         Float
  createdAt     DateTime     @default(now())

  items RadiologyResultItem[]

  @@index([clinicId])
  @@index([patientId])
  @@index([admissionId])
}

model RadiologyResultItem {
  id            String              @id @default(uuid())
  invoiceId     String
  invoice       RadiologyInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId       String?
  order         RadiologyTestOrder? @relation(fields: [orderId], references: [id])
  catalogItemId String?
  catalogItem   RadiologyCatalog?   @relation(fields: [catalogItemId], references: [id])
  testName      String
  resultText    String?
  price         Float

  @@index([invoiceId])
}

// ---- In-Patient / IPD (Tier 3) ----

enum BedStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum MedicationSource {
  CLINIC_SUPPLIED
  PATIENT_OWN
}

model Ward {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name     String

  beds Bed[]

  @@index([clinicId])
}

model Bed {
  id        String    @id @default(uuid())
  wardId    String
  ward      Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  label     String
  dailyRate Float
  status    BedStatus @default(VACANT)

  admissions    Admission[]    @relation("BedAdmissions")
  transfersFrom RoomTransfer[] @relation("TransferFromBed")
  transfersTo   RoomTransfer[] @relation("TransferToBed")

  @@index([wardId])
}

// Everything charged during a stay is recorded against the admission at its
// own price, the same "own recorded charge" discipline as Pharmacy/Lab —
// the discharge bill sums these rather than re-pricing anything later.
model Admission {
  id                String          @id @default(uuid())
  clinicId          String
  clinic            Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId         String
  patient           User            @relation(fields: [patientId], references: [id])
  bedId             String
  bed               Bed             @relation("BedAdmissions", fields: [bedId], references: [id])
  admittingDoctorId String
  admittingDoctor   DoctorProfile   @relation(fields: [admittingDoctorId], references: [id])
  reason            String?
  depositAmount     Float           @default(0)
  status            AdmissionStatus @default(ADMITTED)
  admittedAt        DateTime        @default(now())
  dischargedAt      DateTime?
  dischargeSummary  String?

  roomTransfers     RoomTransfer[]
  doctorVisits      IpdDoctorVisit[]
  procedures        IpdProcedure[]
  medications       IpdMedication[]
  vitalsLogs        IpdVitals[]
  charges           IpdCharge[]
  pharmacySales     PharmacySale[]
  labInvoices       LabInvoice[]
  radiologyInvoices RadiologyInvoice[]
  bill              IpdBill?

  @@index([clinicId])
  @@index([patientId])
  @@index([bedId])
}

model RoomTransfer {
  id            String    @id @default(uuid())
  admissionId   String
  admission     Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  fromBedId     String?
  fromBed       Bed?      @relation("TransferFromBed", fields: [fromBedId], references: [id])
  toBedId       String
  toBed         Bed       @relation("TransferToBed", fields: [toBedId], references: [id])
  transferredAt DateTime  @default(now())

  @@index([admissionId])
}

model IpdDoctorVisit {
  id          String        @id @default(uuid())
  admissionId String
  admission   Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  notes       String?
  fee         Float         @default(0)
  visitedAt   DateTime      @default(now())

  @@index([admissionId])
}

model IpdProcedure {
  id            String    @id @default(uuid())
  admissionId   String
  admission     Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  name          String
  notes         String?
  consentSigned Boolean   @default(false)
  fee           Float     @default(0)
  performedAt   DateTime  @default(now())

  @@index([admissionId])
}

// A clinic-supplied medication is priced and billed; one the patient brought
// themselves is logged for the medical record but never charged.
model IpdMedication {
  id          String           @id @default(uuid())
  admissionId String
  admission   Admission        @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  medicine    String
  dosage      String
  quantity    Int              @default(1)
  unitPrice   Float            @default(0)
  source      MedicationSource
  givenAt     DateTime         @default(now())

  @@index([admissionId])
}

model IpdVitals {
  id           String    @id @default(uuid())
  admissionId  String
  admission    Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  pulse        Int?
  bpSystolic   Int?
  bpDiastolic  Int?
  tempC        Float?
  spo2         Int?
  recordedById String
  recordedBy   User      @relation(fields: [recordedById], references: [id])
  recordedAt   DateTime  @default(now())

  @@index([admissionId])
}

model IpdCharge {
  id          String    @id @default(uuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  chargedAt   DateTime  @default(now())

  @@index([admissionId])
}

// A snapshot taken at discharge, not recomputed afterward — see Admission's
// note above. amountDue can be negative: a refund owed when the deposit
// exceeded the final bill, which the UI must present as a normal outcome.
model IpdBill {
  id                 String    @id @default(uuid())
  admissionId        String    @unique
  admission          Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  roomCharges        Float
  doctorVisitCharges Float
  procedureCharges   Float
  medicationCharges  Float
  adHocCharges       Float
  pharmacyCharges    Float
  labCharges         Float
  radiologyCharges   Float     @default(0)
  subtotal           Float
  taxPercent         Float
  taxAmount          Float
  total              Float
  depositAmount      Float
  amountDue          Float
  createdAt          DateTime  @default(now())
}

// ---- Payments ----

// A single ledger across every bill type, rather than a separate payments
// table per module. billId is a polymorphic reference whose meaning depends
// on billType: an Appointment id for CONSULTATION, a PharmacySale/LabInvoice/
// RadiologyInvoice id for those, or an Admission id for IPD (looked up via
// its IpdBill). Most rows are manually recorded by staff at the counter
// (cash/card/UPI/etc); a RAZORPAY-method row is instead created only once
// razorpayVerify/the webhook has confirmed a real online payment (see
// PaymentOrder below) -- recordedById is still set on it (to whichever user
// account initiated the online payment), keeping "who this is attributed
// to" uniform across every payment method.
model Payment {
  id                String        @id @default(uuid())
  clinicId          String
  clinic            Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId         String
  patient           User          @relation("PatientPayments", fields: [patientId], references: [id])
  billType          BillType
  billId            String
  amount            Float
  method            PaymentMethod
  razorpayOrderId   String?
  razorpayPaymentId String?       @unique // enforces idempotent capture: the client-side verify callback and the webhook can both fire for the same payment, and Postgres allows multiple NULLs so manual (non-Razorpay) rows are unaffected
  recordedById      String
  recordedBy        User          @relation("PaymentsRecorded", fields: [recordedById], references: [id])
  createdAt         DateTime      @default(now())

  @@index([clinicId])
  @@index([billType, billId])
  @@index([patientId])
}

// A Razorpay order created for one specific bill or subscription renewal,
// recorded the moment we ask Razorpay for an order id (before the patient/
// admin has actually paid). This is the server's own record of "what this
// order id is for" -- neither the signed checkout callback nor the webhook
// payload is trusted to carry that context; both look it up here by
// razorpayOrderId instead. Exactly one of (billType+billId) or
// subscriptionId is set, matching `kind`.
model PaymentOrder {
  id                 String            @id @default(uuid())
  clinicId           String
  clinic             Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  razorpayOrderId    String            @unique
  kind               PaymentOrderKind
  billType           BillType?
  billId             String?
  subscriptionId     String?
  patientId          String? // set when kind = BILL; who the payment is for
  initiatedByUserId  String // who clicked "Pay" -- the patient for a bill, a clinic ADMIN for a subscription renewal
  initiatedBy        User              @relation("PaymentOrdersInitiated", fields: [initiatedByUserId], references: [id])
  amount             Float // rupees, snapshotted at order-creation time -- what was actually authorized, regardless of any later change to the bill's balance
  createdAt          DateTime          @default(now())

  @@index([clinicId])
  @@index([billType, billId])
}

enum PaymentOrderKind {
  BILL
  SUBSCRIPTION
}

// ---- Notifications ----

// Every notification attempt is logged, whether it actually sent or not --
// SKIPPED (no SMTP configured, or no valid recipient) is a normal, expected
// status, not an error. This is what lets the whole notification pipeline
// stay testable and auditable even in an environment with no real email
// provider wired up.
model Notification {
  id        String               @id @default(uuid())
  clinicId  String
  clinic    Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId String?
  patient   User?                @relation("PatientNotifications", fields: [patientId], references: [id])
  channel   NotificationChannel
  type      NotificationType
  recipient String
  subject   String?
  body      String
  status    NotificationStatus
  error     String?
  // Set only for channel WHATSAPP (or a future channel with its own
  // provider-assigned id) -- the id the provider's API returned for this
  // send, kept for correlating a future delivery-status webhook back to
  // this row. Null for EMAIL/SMS today.
  providerMessageId String?
  createdAt DateTime             @default(now())

  @@index([clinicId])
  @@index([patientId])
}

// ---- Attachments ----

// Files (lab/radiology report scans, prescription scans) stored on local
// disk (see server/src/utils/uploads.ts) -- fine for this deployment's
// single-EC2-instance architecture (see deploy/README.md), would need S3 if
// it ever scaled beyond one box. entityId is polymorphic on category, same
// pattern as Payment.billId: a LabInvoice id for LAB_REPORT, a
// RadiologyInvoice id for RADIOLOGY_REPORT, a Consultation id for
// PRESCRIPTION_SCAN.
model Attachment {
  id           String             @id @default(uuid())
  clinicId     String
  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId    String
  patient      User               @relation("PatientAttachments", fields: [patientId], references: [id])
  category     AttachmentCategory
  entityId     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String
  uploadedBy   User               @relation("AttachmentsUploaded", fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())

  @@index([clinicId])
  @@index([patientId])
  @@index([category, entityId])
}

// ---- Subscription billing ----
//
// This is deliberately its own actor space, not folded into the clinic-scoped
// User/Role system: every other model in this schema is reachable only
// through a clinicId a JWT carries, but billing a clinic has to work even
// when that clinic can't reach its own data (a lapsed subscription blocks
// exactly that JWT). PlatformAdmin is a wholly separate identity + login +
// token type (see server/src/middleware/platformAuth.ts) so a clinic-scoped
// token can never manage billing and a platform token can never touch
// clinic data.

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED // manually suspended by a platform admin -- blocks access regardless of currentPeriodEnd
  CANCELLED // subscription terminated -- same effect as SUSPENDED, kept distinct for reporting
}

// One row per clinic (not one row per billing period -- SubscriptionPayment
// below is the period-by-period history). "Active" is never just this row's
// status: it's status === ACTIVE AND currentPeriodEnd hasn't passed yet (see
// isSubscriptionActive() in middleware/auth.ts) -- so a lapsed renewal
// blocks access automatically, with no cron job needed to flip a status.
model Subscription {
  id               String             @id @default(uuid())
  clinicId         String             @unique
  clinic           Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tier             Int // the tier this subscription pays for; kept in sync with Clinic.tier by platform.routes.ts, never set independently
  billingCycle     BillingCycle
  status           SubscriptionStatus @default(ACTIVE)
  amount           Float // the fee for the current period, snapshotted at creation/renewal -- see PharmacySaleItem etc. for the same "own recorded charge" discipline
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments   SubscriptionPayment[]
  extensions SubscriptionExtension[]

  @@index([currentPeriodEnd])
}

// A platform admin pushing a subscription's end date out without any payment
// (a trial extension, goodwill days). Kept apart from SubscriptionPayment so
// revenue records only ever hold money that was actually received, and so
// every free extension has a who/why/when trail.
model SubscriptionExtension {
  id                String        @id @default(uuid())
  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  days              Int
  reason            String
  previousPeriodEnd DateTime
  newPeriodEnd      DateTime
  extendedByAdminId String
  extendedByAdmin   PlatformAdmin @relation(fields: [extendedByAdminId], references: [id])
  createdAt         DateTime      @default(now())

  @@index([subscriptionId])
}

// A renewal's own permanent record, independent of Subscription's single
// mutable row -- same rationale as Payment vs. a bill's own running total
// elsewhere in this schema: the row a payment was recorded against should
// never change retroactively just because the subscription's current state
// moved on.
model SubscriptionPayment {
  id                 String         @id @default(uuid())
  subscriptionId     String
  subscription       Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount             Float
  billingCycle       BillingCycle
  periodStart        DateTime
  periodEnd          DateTime
  recordedAt         DateTime       @default(now())
  recordedByAdminId  String?
  recordedByAdmin    PlatformAdmin? @relation(fields: [recordedByAdminId], references: [id])
  // Set instead of recordedByAdminId when a clinic ADMIN pays their own
  // renewal online (self-serve) rather than a platform admin recording a
  // manual payment -- exactly one of the two is set, never both.
  paidByUserId       String?
  paidByUser         User?          @relation("SubscriptionPaymentsPaid", fields: [paidByUserId], references: [id])
  razorpayOrderId    String?
  razorpayPaymentId  String?        @unique
  notes              String?

  @@index([subscriptionId])
}

model PlatformAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  subscriptionPayments   SubscriptionPayment[]
  subscriptionExtensions SubscriptionExtension[]
}

// One-time code for resetting a forgotten password, sent to the user's phone
// on WhatsApp. Only a hash of the code is stored. A code is valid for a short
// window and a limited number of guesses; see auth.routes.ts.
model PasswordResetOtp {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
