DATABASE_URL="postgresql://opd:opd@localhost:5432/opd_care_test"
JWT_SECRET="test-secret-key-not-for-production"
CORS_ORIGIN="http://localhost:5173"

# Fake, test-only Razorpay credentials -- real enough for the pure HMAC
# signature-verification functions to sign/verify against in tests, but
# order creation itself is always injected via resetRazorpayClientForTests()
# in the test suite, so no test ever makes a real network call to Razorpay.
RAZORPAY_KEY_ID="rzp_test_fake0000000000"
RAZORPAY_KEY_SECRET="test-razorpay-key-secret-not-for-production"
RAZORPAY_WEBHOOK_SECRET="test-razorpay-webhook-secret-not-for-production"

# The WhatsApp stub, chosen on purpose, so password reset and other
# WhatsApp features are exercised in tests (see isWhatsAppDeliveryAvailable).
WHATSAPP_PROVIDER="stub"
