generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  PHARMACIST
  LAB_TECHNICIAN
  RADIOLOGY_TECHNICIAN
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

// A clinic is a tenant. Every clinic-owned record is scoped by clinicId so
// one deployment can serve many clinics with isolated data.
model Clinic {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String   @unique
  tier                      Int      @default(1) // 1 = OPD, 2 = +Pharmacy/Lab/Radiology, 3 = +IPD
  logoUrl                   String?
  taxPercent                Float    @default(0)
  doctorRevenueSharePercent Float    @default(0)
  createdAt                 DateTime @default(now())

  users             User[]
  appointments      Appointment[]
  pharmacyItems     PharmacyItem[]
  pharmacySales     PharmacySale[]
  labCatalog        LabTestCatalog[]
  labInvoices       LabInvoice[]
  radiologyCatalog  RadiologyCatalog[]
  radiologyInvoices RadiologyInvoice[]
  wards             Ward[]
  admissions        Admission[]
}

model User {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email     String
  phone     String?
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile            DoctorProfile?
  appointments             Appointment[]      @relation("PatientAppointments")
  pharmacyPurchases        PharmacySale[]     @relation("PharmacySalePatient")
  pharmacySalesHandled     PharmacySale[]     @relation("PharmacySaleSeller")
  labResultsOrdered        LabInvoice[]       @relation("LabInvoicePatient")
  labResultsRecorded       LabInvoice[]       @relation("LabInvoiceRecorder")
  radiologyResultsOrdered  RadiologyInvoice[] @relation("RadiologyInvoicePatient")
  radiologyResultsRecorded RadiologyInvoice[] @relation("RadiologyInvoiceRecorder")
  admissions               Admission[]
  vitalsRecorded           IpdVitals[]

  @@unique([clinicId, email])
  @@unique([clinicId, phone])
  @@index([clinicId])
}

model DoctorProfile {
  id             String @id @default(uuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  department     String
  slotMinutes    Int    @default(15)

  schedules    Schedule[]
  appointments Appointment[]    @relation("DoctorAppointments")
  admissions   Admission[]
  ipdVisits    IpdDoctorVisit[]
}

model Schedule {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String

  @@index([doctorId])
}

model Appointment {
  id          String            @id @default(uuid())
  clinicId    String
  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId    String
  doctor      DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  date        DateTime
  tokenNumber Int
  status      AppointmentStatus @default(BOOKED)
  isWalkIn    Boolean           @default(false)
  reason      String?
  createdAt   DateTime          @default(now())

  consultation      Consultation?
  pharmacySales     PharmacySale[]
  labInvoices       LabInvoice[]
  radiologyInvoices RadiologyInvoice[]

  @@index([clinicId])
  @@index([doctorId, date])
  @@index([patientId])
}

model Consultation {
  id                String      @id @default(uuid())
  appointmentId     String      @unique
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  vitals            Json?
  diagnosis         String?
  notes             String?
  followUpDate      DateTime?
  followUpContacted Boolean     @default(false)
  createdAt         DateTime    @default(now())

  prescriptions    Prescription[]
  labTestsOrdered  LabTestOrder[]
  radiologyOrdered RadiologyTestOrder[]

  @@index([followUpDate])
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medicine       String
  dosage         String
  frequency      String
  durationDays   Int
  notes          String?

  saleItems PharmacySaleItem[]

  @@index([consultationId])
}

// ---- Pharmacy (Tier 2+) ----

// Pricing is always normalized to a base unit (a tablet/piece), never left
// ambiguous between "per strip" and "per unit" — every quantity x price
// calculation elsewhere in the app multiplies quantityInUnits x pricePerUnit,
// regardless of how the item is packaged.
model PharmacyItem {
  id               String   @id @default(uuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name             String
  unitsPerStrip    Int? // null = sold per unit directly (e.g. a syrup bottle)
  pricePerUnit     Float
  costPricePerUnit Float
  stockUnits       Int      @default(0)
  createdAt        DateTime @default(now())

  saleItems PharmacySaleItem[]

  @@index([clinicId])
}

model PharmacySale {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User         @relation("PharmacySalePatient", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  admissionId   String?
  admission     Admission?   @relation(fields: [admissionId], references: [id])
  soldById      String
  soldBy        User         @relation("PharmacySaleSeller", fields: [soldById], references: [id])
  taxPercent    Float        @default(0)
  subtotal      Float
  taxAmount     Float
  total         Float
  createdAt     DateTime     @default(now())

  items PharmacySaleItem[]

  @@index([clinicId])
  @@index([patientId])
  @@index([admissionId])
}

model PharmacySaleItem {
  id             String        @id @default(uuid())
  saleId         String
  sale           PharmacySale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  itemId         String?
  item           PharmacyItem? @relation(fields: [itemId], references: [id])
  medicineName   String
  quantity       Int
  unitPrice      Float
  lineTotal      Float

  @@index([saleId])
}

// ---- Lab (Tier 2+) ----

// Created when a doctor saves a consultation that orders lab tests. Free-text
// name, since at order time there may be no catalog match yet.
model LabTestOrder {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  testName       String
  notes          String?

  resultItems LabResultItem[]

  @@index([consultationId])
}

model LabTestCatalog {
  id          String          @id @default(uuid())
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  resultItems LabResultItem[]

  @@index([clinicId])
}

model LabInvoice {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User         @relation("LabInvoicePatient", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  admissionId   String?
  admission     Admission?   @relation(fields: [admissionId], references: [id])
  recordedById  String
  recordedBy    User         @relation("LabInvoiceRecorder", fields: [recordedById], references: [id])
  taxPercent    Float        @default(0)
  subtotal      Float
  taxAmount     Float
  total         Float
  createdAt     DateTime     @default(now())

  items LabResultItem[]

  @@index([clinicId])
  @@index([patientId])
  @@index([admissionId])
}

model LabResultItem {
  id            String          @id @default(uuid())
  invoiceId     String
  invoice       LabInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId       String?
  order         LabTestOrder?   @relation(fields: [orderId], references: [id])
  catalogItemId String?
  catalogItem   LabTestCatalog? @relation(fields: [catalogItemId], references: [id])
  testName      String
  resultText    String?
  price         Float

  @@index([invoiceId])
}

// ---- Radiology (Tier 2+) ----
// Mirrors the Lab module's pattern exactly: a doctor's free-text order at
// consultation time, a priced catalog, and a counter workflow that
// auto-matches the order to the catalog by name.

model RadiologyTestOrder {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  testName       String
  notes          String?

  resultItems RadiologyResultItem[]

  @@index([consultationId])
}

model RadiologyCatalog {
  id          String                @id @default(uuid())
  clinicId    String
  clinic      Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  resultItems RadiologyResultItem[]

  @@index([clinicId])
}

model RadiologyInvoice {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User         @relation("RadiologyInvoicePatient", fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  admissionId   String?
  admission     Admission?   @relation(fields: [admissionId], references: [id])
  recordedById  String
  recordedBy    User         @relation("RadiologyInvoiceRecorder", fields: [recordedById], references: [id])
  taxPercent    Float        @default(0)
  subtotal      Float
  taxAmount     Float
  total         Float
  createdAt     DateTime     @default(now())

  items RadiologyResultItem[]

  @@index([clinicId])
  @@index([patientId])
  @@index([admissionId])
}

model RadiologyResultItem {
  id            String              @id @default(uuid())
  invoiceId     String
  invoice       RadiologyInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId       String?
  order         RadiologyTestOrder? @relation(fields: [orderId], references: [id])
  catalogItemId String?
  catalogItem   RadiologyCatalog?   @relation(fields: [catalogItemId], references: [id])
  testName      String
  resultText    String?
  price         Float

  @@index([invoiceId])
}

// ---- In-Patient / IPD (Tier 3) ----

enum BedStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum MedicationSource {
  CLINIC_SUPPLIED
  PATIENT_OWN
}

model Ward {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name     String

  beds Bed[]

  @@index([clinicId])
}

model Bed {
  id        String    @id @default(uuid())
  wardId    String
  ward      Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  label     String
  dailyRate Float
  status    BedStatus @default(VACANT)

  admissions    Admission[]    @relation("BedAdmissions")
  transfersFrom RoomTransfer[] @relation("TransferFromBed")
  transfersTo   RoomTransfer[] @relation("TransferToBed")

  @@index([wardId])
}

// Everything charged during a stay is recorded against the admission at its
// own price, the same "own recorded charge" discipline as Pharmacy/Lab —
// the discharge bill sums these rather than re-pricing anything later.
model Admission {
  id                String          @id @default(uuid())
  clinicId          String
  clinic            Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId         String
  patient           User            @relation(fields: [patientId], references: [id])
  bedId             String
  bed               Bed             @relation("BedAdmissions", fields: [bedId], references: [id])
  admittingDoctorId String
  admittingDoctor   DoctorProfile   @relation(fields: [admittingDoctorId], references: [id])
  reason            String?
  depositAmount     Float           @default(0)
  status            AdmissionStatus @default(ADMITTED)
  admittedAt        DateTime        @default(now())
  dischargedAt      DateTime?
  dischargeSummary  String?

  roomTransfers     RoomTransfer[]
  doctorVisits      IpdDoctorVisit[]
  procedures        IpdProcedure[]
  medications       IpdMedication[]
  vitalsLogs        IpdVitals[]
  charges           IpdCharge[]
  pharmacySales     PharmacySale[]
  labInvoices       LabInvoice[]
  radiologyInvoices RadiologyInvoice[]
  bill              IpdBill?

  @@index([clinicId])
  @@index([patientId])
  @@index([bedId])
}

model RoomTransfer {
  id            String    @id @default(uuid())
  admissionId   String
  admission     Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  fromBedId     String?
  fromBed       Bed?      @relation("TransferFromBed", fields: [fromBedId], references: [id])
  toBedId       String
  toBed         Bed       @relation("TransferToBed", fields: [toBedId], references: [id])
  transferredAt DateTime  @default(now())

  @@index([admissionId])
}

model IpdDoctorVisit {
  id          String        @id @default(uuid())
  admissionId String
  admission   Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  notes       String?
  fee         Float         @default(0)
  visitedAt   DateTime      @default(now())

  @@index([admissionId])
}

model IpdProcedure {
  id            String    @id @default(uuid())
  admissionId   String
  admission     Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  name          String
  notes         String?
  consentSigned Boolean   @default(false)
  fee           Float     @default(0)
  performedAt   DateTime  @default(now())

  @@index([admissionId])
}

// A clinic-supplied medication is priced and billed; one the patient brought
// themselves is logged for the medical record but never charged.
model IpdMedication {
  id          String           @id @default(uuid())
  admissionId String
  admission   Admission        @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  medicine    String
  dosage      String
  quantity    Int              @default(1)
  unitPrice   Float            @default(0)
  source      MedicationSource
  givenAt     DateTime         @default(now())

  @@index([admissionId])
}

model IpdVitals {
  id           String    @id @default(uuid())
  admissionId  String
  admission    Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  pulse        Int?
  bpSystolic   Int?
  bpDiastolic  Int?
  tempC        Float?
  spo2         Int?
  recordedById String
  recordedBy   User      @relation(fields: [recordedById], references: [id])
  recordedAt   DateTime  @default(now())

  @@index([admissionId])
}

model IpdCharge {
  id          String    @id @default(uuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  chargedAt   DateTime  @default(now())

  @@index([admissionId])
}

// A snapshot taken at discharge, not recomputed afterward — see Admission's
// note above. amountDue can be negative: a refund owed when the deposit
// exceeded the final bill, which the UI must present as a normal outcome.
model IpdBill {
  id                 String    @id @default(uuid())
  admissionId        String    @unique
  admission          Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  roomCharges        Float
  doctorVisitCharges Float
  procedureCharges   Float
  medicationCharges  Float
  adHocCharges       Float
  pharmacyCharges    Float
  labCharges         Float
  radiologyCharges   Float     @default(0)
  subtotal           Float
  taxPercent         Float
  taxAmount          Float
  total              Float
  depositAmount      Float
  amountDue          Float
  createdAt          DateTime  @default(now())
}
