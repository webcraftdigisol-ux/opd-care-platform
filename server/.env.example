DATABASE_URL="postgresql://opd:opd@localhost:5432/opd_care"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000

# Patient-facing features (self-registration, patient login, booking,
# records, online bill payment -- web and mobile) are off unless this is
# "true". The web app has its own switch, VITE_PATIENT_PORTAL_ENABLED.
# PATIENT_PORTAL_ENABLED="true"
CORS_ORIGIN="http://localhost:5173"

# Optional: where uploaded file attachments (lab/radiology report scans,
# prescription scans) are stored on disk. Defaults to server/uploads if
# unset -- see the design note in README.md on why this is local disk
# rather than S3 for this deployment's single-EC2-instance architecture.
# UPLOADS_ROOT="/var/opd-care/uploads"

# Optional: email notifications (appointment confirmations, payment receipts,
# discharge summaries, follow-up reminders). If any of these are unset,
# notifications still get logged to the Notification table with status
# SKIPPED -- the rest of the app functions normally either way.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="OPD Care <noreply@yourclinic.example>"

# Optional: WhatsApp notifications (reminders, prescriptions, diet plans) via
# Twilio's WhatsApp API, sent from one shared platform-level number across
# every clinic -- see "WhatsApp messaging" in README.md for why. Requires a
# Meta-approved message template per notification type. If any of these are
# unset, WhatsApp sends still get logged to the Notification table with
# status SKIPPED via a stub adapter -- the rest of the app functions
# normally either way.
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Optional: online payments (consultation fees, any bill type, and
# self-serve subscription renewals) via Razorpay, one shared platform-level
# account across every clinic -- see "Online Payments (Razorpay)" in
# README.md for why. If KEY_ID/KEY_SECRET are unset, GET /payments/razorpay/
# status reports {configured: false} and every route that would create a
# real order refuses with a 400 instead of faking a successful payment --
# unlike the WhatsApp stub above, there is no fake-success path here, since
# a phantom "paid" state with no money actually moved is dangerous.
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Separately required for the webhook (the authoritative backstop confirmation
# path -- see README) to accept deliveries; without it, only the client-side
# checkout callback can confirm a payment.
# RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
