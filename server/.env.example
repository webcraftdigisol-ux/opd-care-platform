DATABASE_URL="postgresql://opd:opd@localhost:5432/opd_care"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Optional: where uploaded file attachments (lab/radiology report scans,
# prescription scans) are written on disk. Defaults to server/uploads if
# unset. See UPLOADS_S3_BUCKET below for keeping them in S3 instead.
# UPLOADS_ROOT="/var/opd-care/uploads"

# Optional: store uploaded files in this private S3 bucket instead of on
# local disk (UPLOADS_ROOT is then only a staging area). Credentials come
# from the AWS SDK's default chain -- on EC2, the instance role.
# UPLOADS_S3_BUCKET="opd-care-uploads-123456789012"
# AWS_REGION="ap-south-1"

# Optional: email notifications (appointment confirmations, payment receipts,
# discharge summaries, follow-up reminders). If any of these are unset,
# notifications still get logged to the Notification table with status
# SKIPPED -- the rest of the app functions normally either way.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="OPD Care <noreply@yourclinic.example>"

# Optional: WhatsApp notifications (prescriptions, diet plans, appointment and
# follow-up reminders, password-reset codes), sent from one shared
# platform-level number across every clinic -- see "WhatsApp messaging" in
# README.md. Each message is a Meta-approved template; the exact templates to
# submit are in docs/whatsapp-templates.md. With no provider configured,
# sends are logged to the Notification table via a stub adapter and the rest
# of the app works normally.
#
# WHATSAPP_PROVIDER="meta"   # or "twilio"; unset = whichever is configured.
#                            # "stub" = log instead of sending, on purpose (dev);
#                            # with no provider at all, password reset is hidden.
#
# Meta WhatsApp Cloud API (direct; cheapest in India):
# META_WHATSAPP_TOKEN="EAAG..."
# META_WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# META_WHATSAPP_TEMPLATE_LANG="en"
# META_GRAPH_API_VERSION="v23.0"
#
# Twilio:
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_WHATSAPP_FROM="+14155238886"
# TWILIO_CONTENT_SIDS='{"appointment_reminder":"HX...","prescription_shared":"HX..."}'

# Optional: online payments (consultation fees, any bill type, and
# self-serve subscription renewals) via Razorpay, one shared platform-level
# account across every clinic -- see "Online Payments (Razorpay)" in
# README.md for why. If KEY_ID/KEY_SECRET are unset, GET /payments/razorpay/
# status reports {configured: false} and every route that would create a
# real order refuses with a 400 instead of faking a successful payment --
# unlike the WhatsApp stub above, there is no fake-success path here, since
# a phantom "paid" state with no money actually moved is dangerous.
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Separately required for the webhook (the authoritative backstop confirmation
# path -- see README) to accept deliveries; without it, only the client-side
# checkout callback can confirm a payment.
# RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
